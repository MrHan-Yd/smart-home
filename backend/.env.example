APP_HOST=0.0.0.0
APP_PORT=3002
APP_BASE_URL=http://127.0.0.1:5175
APP_ENV=dev
LOG_LEVEL=info

# 统一认证中心（OAuth）
AUTH_BASE=http://127.0.0.1:3000
OAUTH_CLIENT_ID=app_696b1b
OAUTH_CLIENT_SECRET=change_me
OAUTH_REDIRECT_URI=http://127.0.0.1:3002/oauth/callback
OAUTH_ISSUER=http://127.0.0.1:3000
OAUTH_SCOPES=openid profile email
AUTH_PORTAL_URL=http://127.0.0.1:5173

# PostgreSQL（需自行建库 smart_home）
DATABASE_URL=postgres://postgres:root@127.0.0.1:5432/smart_home?sslmode=disable

# Redis
REDIS_URL=redis://:redis123@127.0.0.1:6379/1

# Home Assistant
HASS_BASE_URL=http://127.0.0.1:8123
HASS_TOKEN=
HASS_TIMEOUT=10s
# 开发期无 HA 也可启动；readyz 是否强制 HA
READYZ_REQUIRE_HA=false

SESSION_COOKIE_NAME=sh_sid
SESSION_TTL=168h
SESSION_IDLE=2h
ACCESS_REFRESH_SKEW=60s
STRICT_JWT=false
COOKIE_SECURE=false
