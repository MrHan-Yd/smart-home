# 认证中心
# 浏览器 authorize：开发可用 http://127.0.0.1:5173（Vite 代理 /oauth）
# 服务端换票：可直连 http://127.0.0.1:3000
# 与 auth-service APP_BASE_URL / 登录页同源（勿混用 localhost 与 127.0.0.1）
AUTH_BASE=http://127.0.0.1:3000

# 若登录页在 Vite：APP_BASE_URL 也应是下面这个（后端 .env）
# APP_BASE_URL=http://127.0.0.1:5173

CLIENT_ID=demo_app
CLIENT_SECRET=demo_secret_change_me
REDIRECT_URI=http://127.0.0.1:9999/oauth/callback

# 浏览器走完 authorize 后填入
# CODE=
# REFRESH_TOKEN=
